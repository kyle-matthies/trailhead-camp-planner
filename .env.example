# Trailhead Camp Planner defaults to its network-free fictional demo.
VITE_DEMO_MODE=true

# Browser-safe Supabase settings. Set VITE_DEMO_MODE=false after creating a new
# Supabase project and applying this repository's migrations.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional local API service. The browser calls this only outside demo mode.
VITE_AI_API_URL=http://127.0.0.1:8000

# Server-side Supabase settings for backend/. Never expose the secret key to Vite.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=

# Optional AI providers used only by the local backend.
GOOGLE_GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Local origins for CORS and invite links.
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
PUBLIC_APP_URL=http://127.0.0.1:5173
